SERVICE_NAME=PREDIX
SERVICE_VERSION=0.3.0
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Video upload — 1 GB default, increase as needed
MAX_UPLOAD_SIZE_BYTES=1073741824
LIVE_MAX_FRAME_BYTES=1500000
LIVE_MAX_FRAME_WIDTH=1280
LIVE_MAX_FRAME_HEIGHT=720
LIVE_MIN_FRAME_INTERVAL_MS=250
# RTSP input is available in the Live Camera view; hostnames must be explicitly allowlisted.
RTSP_ALLOWED_HOSTS=
RTSP_OPEN_TIMEOUT_MS=5000
RTSP_READ_TIMEOUT_MS=2000
UPLOAD_DIR_NAME=uploads
DATABASE_PATH=data/predix.sqlite3

# Computer vision — use auto to prefer Apple MPS, with CPU fallback
MODEL_NAME=yolo11n.pt
DEFAULT_CONF_THRESHOLD=0.25
DEFAULT_IMAGE_SIZE=640
FRAME_STRIDE=1
TRACK_IOU_THRESHOLD=0.3
TRACK_MAX_MISSED_FRAMES=2
DEVICE=auto
